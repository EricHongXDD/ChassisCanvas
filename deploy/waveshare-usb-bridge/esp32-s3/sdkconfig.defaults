# ESP-IDF v5.5.x；与乐鑫 USB RNDIS 官方示例采用同一主版本。
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# USB RNDIS 转发只需要 IPv4。NAPT 必须同时打开 IP forwarding。
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV6=n

# 取自乐鑫 usb_rndis_4g_module 示例的控制传输配置。
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512
CONFIG_USBH_CDC_CONTROL_TRANSFER_BUFFER_SIZE=1025

# 默认不开启实体兼容性确认，固件启动时会失败关闭。
# CONFIG_CASESCREEN_RNDIS_FIRST_VERIFIED is not set
